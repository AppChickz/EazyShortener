# Application
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info
TRUST_PROXY=false
CORS_ORIGINS=
BODY_LIMIT_BYTES=1048576
APP_SECRET=change_me_to_a_strong_random_secret_at_least_32_bytes

# Database
DATABASE_URL=postgresql://eazyshortener:change_me_dev_db_password@localhost:5432/eazyshortener?schema=public&sslmode=disable
POSTGRES_USER=eazyshortener
POSTGRES_PASSWORD=change_me_dev_db_password
POSTGRES_DB=eazyshortener

# JWT authentication
JWT_ACCESS_TTL_SECONDS=3600
JWT_COOKIE_NAME=eazyshortener_session

# Email verification
EMAIL_VERIFICATION_TTL_SECONDS=86400
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
VERIFICATION_RESEND_MAX_PER_HOUR=5

# SMTP
SMTP_HOST=localhost
SMTP_PORT=1125
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=EazyShortener <no-reply@eazyshortener.local>

# API tokens
API_TOKEN_PREFIX=ez_live_
API_TOKEN_BYTES=32
INITIAL_API_TOKEN_TTL_DAYS=30
API_MAX_URLS_PER_REQUEST=10

# Short links
SHORT_CODE_LENGTH=7
SHORT_CODE_MAX_RETRIES=5

# Redis (local Laradock uses authentication; replace with your local Redis password)
REDIS_URL=redis://:change_me_redis_password@localhost:6379
REDIRECT_CACHE_MAX_TTL_SECONDS=3600

# Rate limiting
GUEST_RATE_LIMIT_WINDOW_SECONDS=3600
GUEST_RATE_LIMIT_MAX_REQUESTS=30
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_MAX_REQUESTS=10
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_MAX_REQUESTS=30

# Analytics
ANALYTICS_RETENTION_DAYS=90